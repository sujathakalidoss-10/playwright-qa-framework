{
  "name": "playwright-qa-framework",
  "version": "1.0.0",
  "description": "API (Swagger Petstore) and UI (OrangeHRM) test automation framework built with Playwright + TypeScript",
  "private": true,
  "scripts": {
    "setup": "playwright install chromium",
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui",
    "test:ui:headed": "playwright test --project=ui --headed",
    "test:smoke": "playwright test --grep @smoke",
    "test:negative": "playwright test --grep @negative",
    "report": "playwright show-report reports/html",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.3",
    "zod": "^3.23.8"
  }
}
