# Copy to .env to override. Every value has a safe default in config/env.ts,
# so the suite runs without a .env file.

# Swagger Petstore (keep the trailing slash: request paths are resolved relative to it)
PETSTORE_BASE_URL=https://petstore.swagger.io/v2/
PETSTORE_API_KEY=special-key

# OrangeHRM public demo (credentials are published on the demo login page)
ORANGEHRM_BASE_URL=https://opensource-demo.orangehrmlive.com
ORANGEHRM_USERNAME=Admin
ORANGEHRM_PASSWORD=admin123
